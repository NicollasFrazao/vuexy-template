# Exemplos de Uso do Makefile
# Este arquivo contém exemplos práticos de comandos Make

# ============================================
# SETUP INICIAL
# ============================================

# Primeira vez - setup completo
make install

# Verificar se .env existe
make env-check

# ============================================
# DESENVOLVIMENTO DIÁRIO
# ============================================

# Iniciar o dia
make up

# Ver o que está rodando
make ps
make status

# Ver logs em tempo real
make logs
make logs-app
make logs-nginx

# Acessar container para debug
make shell

# ============================================
# TRABALHANDO COM CÓDIGO
# ============================================

# Adicionar nova dependência PHP
make composer-require PACKAGE=spatie/laravel-permission

# Atualizar dependências
make composer-update

# Regenerar autoload
make composer-dump

# Adicionar dependência JavaScript
make shell-node
npm install axios
exit

# ============================================
# ASSETS E FRONTEND
# ============================================

# Compilar para desenvolvimento (uma vez)
make npm-dev

# Compilar para produção
make npm-build

# Observar mudanças (watch mode)
make npm-watch

# Ver logs do Vite
make logs-node

# ============================================
# BANCO DE DADOS
# ============================================

# Criar nova migration
make artisan CMD="make:migration create_posts_table"

# Executar migrations
make migrate

# Resetar banco e executar migrations
make migrate-fresh

# Executar seeders
make seed

# Reset completo (migrations + seeders)
make fresh

# Reverter última migration
make migrate-rollback

# Acessar MySQL diretamente
make mysql-cli

# ============================================
# ARTISAN COMMANDS
# ============================================

# Listar rotas
make artisan CMD="route:list"

# Criar controller
make artisan CMD="make:controller PostController"

# Criar model
make artisan CMD="make:model Post -m"

# Criar seeder
make artisan CMD="make:seeder PostSeeder"

# Criar request
make artisan CMD="make:request StorePostRequest"

# Abrir Tinker
make tinker

# ============================================
# CACHE
# ============================================

# Limpar cache da aplicação
make cache-clear

# Limpar cache de configuração
make config-clear

# Limpar cache de rotas
make route-clear

# Limpar cache de views
make view-clear

# Limpar todos os caches
make clear-all

# Otimizar para produção
make cache-optimize

# ============================================
# TESTES
# ============================================

# Executar todos os testes
make test

# Executar teste específico
make test-filter FILTER=DashboardTest

# Executar com cobertura
make test-coverage

# Executar em paralelo
make test-parallel

# ============================================
# TROUBLESHOOTING
# ============================================

# Problemas de permissão
make permissions

# Containers não iniciam
make down
make clean-build

# Banco não conecta
make logs-mysql
# Aguarde "ready for connections"

# Assets não compilam
make shell-node
rm -rf node_modules package-lock.json
npm install
npm run build
exit

# Reset completo
make reset

# ============================================
# LIMPEZA
# ============================================

# Parar containers
make down

# Remover tudo (containers, volumes, imagens)
make clean

# Remover e reconstruir
make clean-build

# Limpar recursos Docker não utilizados
make prune

# ============================================
# INFORMAÇÕES
# ============================================

# Ver informações da aplicação
make info

# Ver status dos containers
make status

# Ver todos os comandos
make help

# ============================================
# GIT (ATALHOS)
# ============================================

# Ver status
make git-status

# Commit rápido
make git-commit MSG="feat: adicionar nova feature"

# Push
make git-push

# ============================================
# WORKFLOWS COMPLETOS
# ============================================

# Nova feature com migration
make artisan CMD="make:migration create_posts_table"
make artisan CMD="make:model Post"
make artisan CMD="make:controller PostController"
make migrate
make test

# Deploy preparation
make test
make npm-build
make cache-optimize
make prod-build

# Desenvolvimento com hot-reload
make up
make dev  # Inicia Vite com hot-reload

# Debugging
make logs-app        # Ver logs da aplicação
make shell           # Entrar no container
tail -f storage/logs/laravel.log  # Ver logs do Laravel

# ============================================
# PRODUÇÃO
# ============================================

# Build de produção
make prod-build

# Otimizar tudo
make cache-optimize
make composer-dump

# ============================================
# ATALHOS ÚTEIS
# ============================================

# Alias para install
make quick-start

# Reconstruir tudo
make rebuild

# Reset completo
make reset

# Ambiente de desenvolvimento
make dev
